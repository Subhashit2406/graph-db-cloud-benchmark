# ==============================================================================
# Graph Database Cloud Benchmark - Environment Configuration Template
# Copy this file to '.env' and fill in your target database credentials.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Active Target Database Adapter
# Options: cognodb | neo4j | neptune | memgraph
TARGET_DB_ADAPTER=cognodb

# Benchmark Execution Settings
BENCHMARK_CONCURRENCY=5
BENCHMARK_WARMUP_ITERATIONS=10
BENCHMARK_MEASURE_ITERATIONS=100
BENCHMARK_TIMEOUT_SECONDS=60.0

# Dataset Paths
DATASET_NODES_PATH=datasets/processed/nodes.csv
DATASET_EDGES_PATH=datasets/processed/edges.csv

# Output Settings
RESULTS_DIR=results_data
RESULTS_EXPORT_FORMAT=json

# ------------------------------------------------------------------------------
# CognoDB Credentials (Neo4j driver based)
# ------------------------------------------------------------------------------
COGNODB_URI=bolt+s://db-c3a9296d.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=68698430dbd070100b499987d73b17f4
COGNODB_DATABASE=neo4j
COGNODB_MAX_POOL_SIZE=50
COGNODB_CONN_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# Neo4j / Neo4j Aura Credentials
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_password_here
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# AWS Neptune Credentials
# ------------------------------------------------------------------------------
NEPTUNE_ENDPOINT=your-neptune-cluster.cluster-xyz.us-east-1.neptune.amazonaws.com
NEPTUNE_PORT=8182
NEPTUNE_REGION=us-east-1
NEPTUNE_USE_SSL=true

# ------------------------------------------------------------------------------
# Memgraph Cloud Credentials
# ------------------------------------------------------------------------------
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=your_memgraph_password_here
